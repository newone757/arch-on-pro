# Generated by Omarchy from ~/.config/omarchy/themed/lazydocker.yml.tpl on
# every theme change; ~/.config/lazydocker/config.yml is a symlink to it.
# Matches btop: thin, quiet borders in the theme's own colours instead of
# lazydocker's stock bold green/white and solid bright-blue selection.
gui:
  theme:
    activeBorderColor:
      - "{{ accent }}"
    inactiveBorderColor:
      - "{{ muted }}"
    selectedLineBgColor:
      - "{{ mix background foreground 0.12 }}"
    optionsTextColor:
      - "{{ accent }}"
