#!/bin/bash
# Recolor OmarchyIcons folder icons to match the active theme.
#
# omarchy theme set only writes gsettings icon-theme from the theme's
# icons.theme file — it doesn't generate the OmarchyIcons folder itself.
# Without this hook, every theme switch silently points gsettings at an
# icon theme that doesn't exist on disk, breaking icon resolution
# system-wide (not just folder icons — anything that falls through the
# inheritance chain, e.g. notification icons).

THEME_NAME="$1"
OMARCHY_THEMES="$OMARCHY_PATH/themes"
USER_THEMES="$HOME/.config/omarchy/themes"
CURRENT_THEME="$HOME/.local/state/omarchy/current/theme"

# Skip if this wasn't a real theme change (defensive — mirrors the old
# 3.5.1 hook's guard against synthetic callers).
if [[ ! -d "$OMARCHY_THEMES/$THEME_NAME" && ! -d "$USER_THEMES/$THEME_NAME" ]]; then
  exit 0
fi

ICONS_COLOR_FILE="$CURRENT_THEME/icons.color"
ICONS_THEME_FILE="$CURRENT_THEME/icons.theme"
ICONS_THEME_VAL="$([[ -f $ICONS_THEME_FILE ]] && cat "$ICONS_THEME_FILE" || echo '')"

# Theme ships its own non-OmarchyIcons icon theme (e.g. a stock theme using
# Yaru) — respect it, don't overwrite with a recolored Papirus fork.
if [[ -n "$ICONS_THEME_VAL" && "$ICONS_THEME_VAL" != "OmarchyIcons" ]]; then
  exit 0
fi

if [[ -f "$ICONS_COLOR_FILE" ]]; then
  omarchy-icons-apply-color "$(<"$ICONS_COLOR_FILE")"
else
  # Derive from colors.toml: accent, then magenta/blue, then foreground.
  COLORS_FILE="$CURRENT_THEME/colors.toml"
  if [[ -f "$COLORS_FILE" ]]; then
    for key in accent magenta blue foreground; do
      color_hex=$(sed -n "s/^${key}\s*=\s*\"\(#[0-9a-fA-F]\{6\}\)\"/\1/p" "$COLORS_FILE" | head -1)
      [[ -n "$color_hex" ]] && break
    done
    [[ -n "$color_hex" ]] && omarchy-icons-apply-color "$color_hex"
  fi
fi
